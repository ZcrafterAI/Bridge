# Optional: name of the Zowe zosmf profile (defaults to "default")
MAINFRAME_WORKFLOW_ZOWE_PROFILE=default

# Optional: path to the built credential-resolver script
MAINFRAME_WORKFLOW_CREDENTIAL_RESOLVER=./credential-resolver/dist/resolver.js

# Request store and archive (defaults are fine for local use)
MAINFRAME_WORKFLOW_DB_PATH=./mainframe_workflow_mcp/state.db
MAINFRAME_WORKFLOW_ARCHIVE_DIR=./mainframe_workflow_mcp/archive
MAINFRAME_WORKFLOW_IDLE_DAYS=14
MAINFRAME_WORKFLOW_RETENTION_DAYS=90
MAINFRAME_WORKFLOW_HTTP_TIMEOUT_SECONDS=30

# Optional: API Mediation Layer base path, if your site uses one
MAINFRAME_WORKFLOW_APIML_BASE_PATH=

# How a person approves a spec or a plan (the agent never can):
#   auto      your AI client's own prompt when it has one, else a page in your browser
#   prompt    your AI client's prompt only
#   browser   a page on this machine only
#   terminal  run `python -m mainframe_workflow_mcp.approve` (no browser needed)
MAINFRAME_WORKFLOW_APPROVAL=auto
MAINFRAME_WORKFLOW_APPROVAL_WAIT_SECONDS=60

# true: offer no tool that changes anything
MAINFRAME_WORKFLOW_READ_ONLY=false

# Datasets nothing may write to, comma separated (* is one qualifier, ** is any)
MAINFRAME_WORKFLOW_PROTECTED_DATASETS=

# TSO account number, for z/OSMF without the one-request TSO interface
MAINFRAME_WORKFLOW_TSO_ACCOUNT=
