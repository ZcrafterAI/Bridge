# Optional: name of the Zowe zosmf profile (defaults to "default")
MAINFRAME_WORKFLOW_ZOWE_PROFILE=default

# Optional: path to the built credential-resolver script
MAINFRAME_WORKFLOW_CREDENTIAL_RESOLVER=./credential-resolver/dist/resolver.js

# Request store and archive (defaults are fine for local use)
MAINFRAME_WORKFLOW_DB_PATH=./mainframe_workflow_mcp/state.db
MAINFRAME_WORKFLOW_ARCHIVE_DIR=./mainframe_workflow_mcp/archive
MAINFRAME_WORKFLOW_IDLE_DAYS=14
MAINFRAME_WORKFLOW_RETENTION_DAYS=90
MAINFRAME_WORKFLOW_HTTP_TIMEOUT_SECONDS=30

# Optional: API Mediation Layer base path, if your site uses one
MAINFRAME_WORKFLOW_APIML_BASE_PATH=
