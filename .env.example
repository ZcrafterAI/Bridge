# Credentials: "resolver" (default) reads your local Zowe team config + OS
# keychain via credential-resolver -- fine on a developer's own machine, but
# there is no OS keychain inside a container. Set "env" in KinD/containers
# and fill in the ZOSMF_* vars below instead (fed by a K8s Secret there).
MAINFRAME_WORKFLOW_CREDENTIAL_SOURCE=resolver

# Optional: name of the Zowe zosmf profile (defaults to "default"). Only used
# when CREDENTIAL_SOURCE=resolver.
MAINFRAME_WORKFLOW_ZOWE_PROFILE=default

# Optional: path to the built credential-resolver script. Only used when
# CREDENTIAL_SOURCE=resolver.
MAINFRAME_WORKFLOW_CREDENTIAL_RESOLVER=./credential-resolver/dist/resolver.js

# Z Xplore (or any other z/OSMF target) connection details. Only used when
# CREDENTIAL_SOURCE=env.
MAINFRAME_WORKFLOW_ZOSMF_HOST=
MAINFRAME_WORKFLOW_ZOSMF_PORT=443
MAINFRAME_WORKFLOW_ZOSMF_USER=
MAINFRAME_WORKFLOW_ZOSMF_PASSWORD=
MAINFRAME_WORKFLOW_ZOSMF_PROTOCOL=https
MAINFRAME_WORKFLOW_ZOSMF_REJECT_UNAUTHORIZED=true

# Action-log store (audit trail only: tool, target, status — never job content)
MAINFRAME_WORKFLOW_DB_PATH=./mainframe_workflow_mcp/state.db
MAINFRAME_WORKFLOW_HTTP_TIMEOUT_SECONDS=30

# Optional: API Mediation Layer base path, if your site uses one
MAINFRAME_WORKFLOW_APIML_BASE_PATH=

# MCP transport: bridge runs as a network service (Streamable HTTP) so
# backend can reach it as an MCP client, rather than being spawned as a
# local stdio subprocess.
MAINFRAME_WORKFLOW_MCP_TRANSPORT=http
MAINFRAME_WORKFLOW_MCP_HOST=0.0.0.0
MAINFRAME_WORKFLOW_MCP_PORT=8000
MAINFRAME_WORKFLOW_MCP_PATH=/mcp
